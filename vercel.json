{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/rocadeiras",
      "destination": "/rocadeiras/index.html"
    },
    {
      "source": "/img/products/:name",
      "destination": "/api/product-images?name=:name"
    },
    {
      "source": "/loja/((?!.*\\.).+)",
      "destination": "/loja/index.html"
    }
  ]
}
